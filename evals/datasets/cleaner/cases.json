[
  {
    "id": "CLN01",
    "name": "dates_mixed_formats_dayfirst",
    "description": "Ten date notations in one file; dd/mm is provable from other rows; two cells are impossible and must be flagged, not guessed.",
    "file": "CLN01_dates_mixed_formats_dayfirst.csv",
    "mapping": {
      "Emp ID": {
        "target_field": "employee_id",
        "transform": "direct"
      },
      "Joined": {
        "target_field": "start_date",
        "transform": "direct"
      },
      "Born": {
        "target_field": "date_of_birth",
        "transform": "direct"
      }
    },
    "expected": {
      "E1": {
        "start_date": "2019-02-03",
        "date_of_birth": "1990-05-14"
      },
      "E2": {
        "start_date": "2020-07-14",
        "date_of_birth": "1988-03-14"
      },
      "E3": {
        "start_date": "2021-03-09",
        "date_of_birth": "1992-07-04"
      },
      "E4": {
        "start_date": "2018-11-05",
        "date_of_birth": "1985-12-01"
      },
      "E5": {
        "start_date": "2017-09-09",
        "date_of_birth": "1995-01-01"
      },
      "E6": {
        "start_date": "2016-12-31",
        "date_of_birth": "1996-02-29"
      },
      "E7": {
        "start_date": {
          "flag": true
        },
        "date_of_birth": "1991-08-08"
      },
      "E8": {
        "start_date": {
          "flag": true
        },
        "date_of_birth": "1989-09-09"
      }
    },
    "required_tools": {
      "start_date": [
        "normalize_date"
      ],
      "date_of_birth": [
        "normalize_date"
      ]
    }
  },
