{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "employee.schema.json",
  "title": "Employee migration target schema",
  "description": "Canonical HRMS target contract. The AI classifier infers source semantics; this schema contains no source aliases.",
  "type": "object",
  "additionalProperties": false,
  "required": ["employee_id", "first_name", "last_name", "email", "start_date", "annual_salary"],
  "properties": {
    "employee_id": {"type": "string", "minLength": 1, "description": "Stable employee identifier."},
    "first_name": {"type": "string", "minLength": 1, "description": "Employee given name."},
    "last_name": {"type": "string", "minLength": 1, "description": "Employee family name."},
    "email": {"type": "string", "format": "email", "description": "Work email address."},
    "phone": {"type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$", "description": "Employee work or mobile phone, E.164."},
    "date_of_birth": {"type": "string", "format": "date", "description": "Date of birth."},
    "start_date": {"type": "string", "format": "date", "description": "Employment joining date."},
    "end_date": {"type": "string", "format": "date", "description": "Employment end date."},
    "department": {"type": "string", "description": "Organisational department."},
    "job_title": {"type": "string", "description": "Employee job title (a role name, not a grade code)."},
    "manager_employee_id": {"type": "string", "description": "Direct manager employee identifier."},
    "location": {"type": "string", "description": "Primary work location."},
    "employment_status": {"type": "string", "enum": ["active", "resigned", "terminated", "on_leave"], "description": "Current employment state."},
    "annual_salary": {"type": "number", "exclusiveMinimum": 0, "description": "Annual gross salary. Never guessed: a blank source value is escalated."}
  }
}
